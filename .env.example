APP_NAME=TG Market Radar
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./telescope.db
ADMIN_API_KEY=change-me-to-a-long-random-value

# Telegram application credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# A StringSession for a dedicated service account. Never commit this value.
TG_SESSION=
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_WEBHOOK_SECRET=
# Optional comma-separated chat IDs allowed to administer the bot.
TG_ADMIN_CHAT_IDS=

# MAX Bot API (bot UI; global MAX channel search is not available in the official API)
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=

# Referral destination, for example MyProductBot (without @)
REFERRAL_BOT_USERNAME=

# Optional Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Search safety / resource budgets
SEARCH_RESULT_LIMIT=100
MESSAGE_SCAN_LIMIT=300
RETENTION_DAYS=90
